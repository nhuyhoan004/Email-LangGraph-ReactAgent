# Cấu hình LLM.
# Provider: openai, openrouter, google hoặc claude.
EMAIL_AGENT_PROVIDER=claude

# Chỉ cần điền key của provider đang chọn.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=AIza...

# Để trống để dùng model mặc định theo provider hoặc điền model tùy chọn.
# Ví dụ: gpt-4o-mini, openai/gpt-4o-mini, gemini-2.0-flash, claude-opus-5.
EMAIL_AGENT_MODEL=

# Cấu hình Gmail, độc lập với cấu hình LLM.
# Đường dẫn đến tệp OAuth tải từ Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
