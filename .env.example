# Provider: openai, openrouter, google, hoac claude
EMAIL_AGENT_PROVIDER=claude

# Chi can dien key cua provider dang chon
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=AIza...

# De trong de dung model mac dinh theo provider, hoac dien model tuy chon.
# Vi du: gpt-4o-mini, openai/gpt-4o-mini, gemini-2.0-flash, claude-opus-5
EMAIL_AGENT_MODEL=

# Duong dan OAuth cua Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
